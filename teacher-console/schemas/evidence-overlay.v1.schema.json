{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.evidence-overlay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "overlay_id",
    "overlay_fingerprint",
    "review_status",
    "source_scope",
    "units"
  ],
  "properties": {
    "schema": {"const": "wuli.evidence-overlay.v1"},
    "overlay_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "overlay_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_status": {"enum": ["draft", "teacher_approved"]},
    "source_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "evidence-unit.v1.schema.json"}
    }
  }
}
