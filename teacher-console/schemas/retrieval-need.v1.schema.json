{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.retrieval-need.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "need_id",
    "purpose",
    "question",
    "required_facets",
    "forbidden_conflicts",
    "minimum_authority",
    "criticality",
    "target_ids",
    "stage_ids",
    "obligation_ids"
  ],
  "properties": {
    "schema": {"const": "wuli.retrieval-need.v1"},
    "need_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "purpose": {
      "enum": [
        "method_candidate",
        "applicability_check",
        "exception_check",
        "boundary_check",
        "verification_support",
        "false_friend_check"
      ]
    },
    "question": {"type": "string", "minLength": 1, "maxLength": 1000},
    "required_facets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "forbidden_conflicts": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "diagnostic_targets": {
      "description": "Errors being diagnosed by this need; their presence in the current work does not by itself make corrective evidence inapplicable.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "minimum_authority": {"enum": ["A", "B", "C", "D"]},
    "criticality": {"enum": ["required", "optional"]},
    "target_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stage_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "obligation_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
