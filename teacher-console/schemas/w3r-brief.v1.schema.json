{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.w3r-brief.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem_fingerprint",
    "proof_package_fingerprint",
    "question_targets",
    "final_answers",
    "proof_skeleton",
    "verified_claims",
    "verification_obligations",
    "teaching_cues",
    "method_scope",
    "allowed_symbols"
  ],
  "properties": {
    "schema": {"const": "wuli.w3r-brief.v1"},
    "problem_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof_package_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "question_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "prompt", "response_mode"],
        "properties": {
          "target_id": {"type": "string"},
          "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
          "response_mode": {"enum": ["single", "enumerate_all", "prove", "explain"]}
        }
      }
    },
    "final_answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "text", "answer_signature", "claim_ids", "complete"],
        "properties": {
          "target_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "answer_signature": {"type": "string", "minLength": 1, "maxLength": 2000},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "complete": {"type": "boolean"}
        }
      }
    },
    "proof_skeleton": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "target_ids", "claim_ids", "depends_on", "statement", "formula_latex", "conditions", "teaching_role"],
        "properties": {
          "step_id": {"type": "string"},
          "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "formula_latex": {"type": "string", "maxLength": 2000},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "teaching_role": {"enum": ["setup", "derivation", "substitution", "conclusion", "check"]}
        }
      }
    },
    "verified_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "conditions", "status", "certificate_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "status": {"const": "verified"},
          "certificate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "verification_obligations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "target_id", "check", "render_as", "resolved"],
        "properties": {
          "obligation_id": {"type": "string"},
          "target_id": {"type": "string"},
          "check": {"type": "string", "minLength": 1, "maxLength": 1000},
          "render_as": {"enum": ["condition", "self_check", "teacher_note"]},
          "resolved": {"type": "boolean"}
        }
      }
    },
    "teaching_cues": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_id", "step_ids", "instruction"],
        "properties": {
          "cue_id": {"type": "string"},
          "step_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "instruction": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "method_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "max_main_steps", "forbidden_methods"],
      "properties": {
        "level": {"const": "high_school"},
        "max_main_steps": {"type": "integer", "minimum": 1, "maximum": 5},
        "forbidden_methods": {"type": "array", "items": {"type": "string"}}
      }
    },
    "allowed_symbols": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
  }
}
