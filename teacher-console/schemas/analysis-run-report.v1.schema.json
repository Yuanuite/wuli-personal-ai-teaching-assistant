{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.analysis-run-report.v1",
  "title": "解析运行账本报告（wuli.analysis-run-report.v1）",
  "description": "一次解析（analysis.generate / W3 shadow）的只读运行报告：路由、模型身份、阶段步骤、计数、验证、终态与脱敏类别。Wave A3 冻结。生产方为 teacher-console/scripts/analysis_run_report.py。",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"
    }
  },
  "required": [
    "schema",
    "run",
    "runtime_identities",
    "steps",
    "counts",
    "verification_summary",
    "terminal",
    "redactions"
  ],
  "properties": {
    "schema": {"const": "wuli.analysis-run-report.v1"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
      },
      "required": ["job_id", "entry_id", "status", "mode", "selected_route"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "entry_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {
          "enum": ["queued", "running", "completed", "failed", "blocked", "provisional"]
        },
        "mode": {"type": "string", "minLength": 1, "maxLength": 80},
        "selected_route": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "runtime_identities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
        },
        "required": ["registered_id", "source"],
        "properties": {
          "registered_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "provider": {"type": ["string", "null"], "maxLength": 120},
          "upstream_model": {"type": ["string", "null"], "maxLength": 120},
          "config_digest": {"type": ["string", "null"], "maxLength": 80},
          "route_mode": {"type": ["string", "null"], "maxLength": 80},
          "model_display_name": {"type": ["string", "null"], "maxLength": 200},
          "kind": {
            "enum": ["model", "checkpoint", "local-verifier", "human", "unknown"]
          },
          "source": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
        },
        "required": [
          "step_id",
          "name",
          "category",
          "verification_result",
          "verification_obligations"
        ],
        "properties": {
          "step_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "category": {"type": "string", "minLength": 1, "maxLength": 40},
          "contract": {"type": "string", "minLength": 1, "maxLength": 200},
          "input_fingerprint": {
            "type": ["string", "null"],
            "maxLength": 300,
            "pattern": "^(sha256:[0-9a-f]{64}|missing|not-applicable)$"
          },
          "runtime_identity": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "propertyNames": {
              "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
            },
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": ["model", "checkpoint", "local-verifier", "human", "unknown"]
              },
              "registered_id": {"type": ["string", "null"], "maxLength": 120},
              "provider": {"type": ["string", "null"], "maxLength": 120},
              "source": {"type": ["string", "null"], "maxLength": 200}
            }
          },
          "started_at": {"type": ["string", "null"], "maxLength": 80},
          "duration": {"type": ["number", "null"], "minimum": 0},
          "attempt_count": {"type": "integer", "minimum": 0},
          "upstream_request_count": {"type": "integer", "minimum": 0},
          "artifact_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 400,
              "not": {"pattern": "^(/|[A-Za-z]:[/\\\\]|~/)"}
            }
          },
          "verification_obligations": {
            "type": "array",
            "items": {"type": "string", "maxLength": 300}
          },
          "verification_result": {
            "enum": ["passed", "failed", "provisional", "not-run"]
          },
          "verification_note": {"type": "string", "maxLength": 1000},
          "failure_type": {"type": ["string", "null"], "maxLength": 200},
          "retry_or_backjump": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "propertyNames": {
              "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
            },
            "properties": {
              "type": {"enum": ["retry", "backjump"]},
              "scope": {"type": "string", "maxLength": 200},
              "attempts_used": {"type": "integer", "minimum": 0}
            }
          },
          "terminal_effect": {"type": ["string", "null"], "maxLength": 400}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
      },
      "required": [
        "logical_stage_count",
        "provider_attempt_count",
        "upstream_request_count",
        "checkpoint_replay_count",
        "rollback_count",
        "supplemental_analysis_count",
        "control_transition_count"
      ],
      "properties": {
        "logical_stage_count": {"type": "integer", "minimum": 0},
        "provider_attempt_count": {"type": "integer", "minimum": 0},
        "upstream_request_count": {"type": "integer", "minimum": 0},
        "checkpoint_replay_count": {"type": "integer", "minimum": 0},
        "rollback_count": {"type": "integer", "minimum": 0},
        "supplemental_analysis_count": {"type": "integer", "minimum": 0},
        "control_transition_count": {"type": "integer", "minimum": 0}
      }
    },
    "verification_summary": {
      "type": "object",
      "propertyNames": {
        "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
      }
    },
    "terminal": {
      "type": "object",
      "propertyNames": {
        "not": {"pattern": "(?i)(api[_-]?key|sk-|authorization|data:)"}
      }
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 200}
    }
  }
}
