{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.evidence-unit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "unit_kind",
    "source_kind",
    "source_locator",
    "text",
    "physics_facets",
    "applicability",
    "exceptions",
    "authority_level",
    "content_hash"
  ],
  "properties": {
    "schema": {"const": "wuli.evidence-unit.v1"},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "unit_kind": {
      "enum": [
        "secondary_conclusion",
        "method_applicability",
        "false_friend_warning",
        "verification_rule"
      ]
    },
    "source_kind": {
      "enum": [
        "curated_technique",
        "deterministic_formula",
        "approved_solution",
        "approved_physics_model",
        "teacher_feedback",
        "evaluator_warning",
        "agent_candidate",
        "routing_summary"
      ]
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1, "maxLength": 500},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "physics_facets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "exceptions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "authority_level": {"enum": ["A", "B", "C", "D", "N"]},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
