{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.w3r-routing.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "mode", "gray_entry_ids", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"const": "wuli-w3r-routing-v1"},
    "mode": {"enum": ["off", "shadow", "gray", "default"]},
    "gray_entry_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_digest",
        "paired_case_count",
        "teacher_reviewed_case_count",
        "fresh_holdout_case_count",
        "fresh_holdout_target_count",
        "final_answer_fidelity",
        "claim_support_coverage",
        "condition_retention",
        "target_coverage",
        "latex_validity",
        "unsupported_claim_rate",
        "teacher_readability_preference",
        "teacher_edit_rate_non_regression"
      ],
      "properties": {
        "report_digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "paired_case_count": {"type": "integer", "minimum": 0},
        "teacher_reviewed_case_count": {"type": "integer", "minimum": 0},
        "fresh_holdout_case_count": {"type": "integer", "minimum": 0},
        "fresh_holdout_target_count": {"type": "integer", "minimum": 0},
        "final_answer_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "claim_support_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "condition_retention": {"type": "number", "minimum": 0, "maximum": 1},
        "target_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "latex_validity": {"type": "number", "minimum": 0, "maximum": 1},
        "unsupported_claim_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "teacher_readability_preference": {"type": "number", "minimum": 0, "maximum": 1},
        "teacher_edit_rate_non_regression": {"type": "boolean"}
      }
    }
  }
}
