{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuli.evidence-gold-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "dataset_fingerprint",
    "reviewer",
    "reviewed_at",
    "status",
    "decisions"
  ],
  "properties": {
    "schema": {"const": "wuli.evidence-gold-review.v1"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "dataset_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 120},
    "reviewed_at": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"enum": ["approved", "changes_requested"]},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "decision", "note"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "decision": {"enum": ["approved", "changes_requested"]},
          "note": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
