        "section": "ideal-transformer-ratio-ledger",
        "start_line": 1,
        "end_line": 1
      },
      "text": "理想变压器满足 U1/U2=N1/N2，且输入功率等于输出功率，所以 I1/I2=N2/N1；电压比与电流比互为倒数。",
      "physics_facets": [
        "交变电流",
        "理想变压器",
        "匝数比",
        "电压比",
        "电流比",
        "功率守恒"
      ],
      "applicability": [
        "理想变压器",
        "忽略漏磁与线圈损耗"
      ],
      "exceptions": [
        "把电流比写成匝数比同向",
        "非理想变压器仍直接令输入功率等于输出功率",
        "直流稳态接入变压器仍套匝数比"
      ],
      "authority_level": "A",
      "content_hash": "sha256:1b33853433c971f8d218c620ab6d3cd8b67c5e3e478757218c90dcc9b04135de"
