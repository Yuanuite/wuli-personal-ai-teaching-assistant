      "source_locator": {
        "path": "teacher-console/tests/fixtures/evidence-agent/fresh-holdout-v3-evidence-overlay.json",
        "section": "ideal-gas-fixed-amount-state-law",
        "start_line": 1,
        "end_line": 1
      },
      "text": "一定质量的理想气体在两个平衡态之间满足 pV/T 为常量，其中 T 必须使用热力学温度；只有气体物质的量不变时才能直接比较。等温、等容、等压过程分别是该关系在相应约束下的特例。",
      "physics_facets": [
        "理想气体",
        "一定质量",
        "平衡态",
        "压强",
        "体积",
        "热力学温度"
      ],
      "applicability": [
        "气体可视为理想气体",
        "物质的量不变",
        "比较确定的平衡态"
      ],
      "exceptions": [
        "把摄氏温度直接代入状态方程比例",
        "容器漏气后仍按一定质量处理",
        "非平衡瞬态仍直接使用统一压强和温度"
      ],
      "authority_level": "A",
      "content_hash": "sha256:fb2b2aa9e95aa35f56c43adacf3619422c6de32add4d3ed8cfdeea3c05bc6789"
    },
    {
