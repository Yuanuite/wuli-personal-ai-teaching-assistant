{
  "schema": "complex-process-decomposition.v1",
  "status": "completed",
  "problem_profile": {
    "summary": "Refactor the teacher-console into an auditable MiMo vision to DeepSeek API reasoning and SVG collaboration pipeline.",
    "process_shape": "hybrid",
    "epistemic_families": ["engineering", "procedural", "physics"],
    "source_policy": "provided-material",
    "authoritative_inputs": ["approved source image", "model registry", "teacher lifecycle gates"],
    "assumptions": ["mimo-v2.5-flash and deepseek-v4-flash-api are probe-passed"],
    "constraints": ["MiMo does not solve", "DeepSeek does not approve", "model failure is fail-closed"],
    "excluded_scope": ["automatic approval", "automatic publication", "direct model-authored simulator HTML"]
  },
  "targets": [
    {"id": "T1", "description": "Every source image is converted into versioned visual facts by MiMo.", "success_criteria": ["Trace identifies mimo-v2.5-flash", "Uncertainty blocks source approval"], "priority": "critical", "required_evidence": ["visual-facts", "source-review-report"], "approval": "human-owner"},
    {"id": "T2", "description": "Reasoning and editable generation tasks use DeepSeek V4 Flash API without silent fallback.", "success_criteria": ["Trace identifies deepseek-v4-flash-api and openai-compatible provider"], "priority": "critical", "required_evidence": ["agent-stage-trace"], "approval": "system"},
    {"id": "T3", "description": "Static SVG generation demonstrably consumes both MiMo facts and DeepSeek output.", "success_criteria": ["SVG trace binds both input and output fingerprints", "Unsafe SVG is rejected"], "priority": "critical", "required_evidence": ["svg-provenance", "svg-gate-report"], "approval": "domain-expert"},
    {"id": "T4", "description": "The teacher lifecycle preserves every approval and privacy gate.", "success_criteria": ["Isolated E2E stops at needs-answer-review", "No model can approve or finish"], "priority": "critical", "required_evidence": ["isolated-e2e-report"], "approval": "human-owner"}
  ],
  "process_model": {
    "kind": "hybrid",
    "nodes": [
      {"id": "P1", "label": "Visual facts frozen", "state_in": ["source image"], "state_out": ["visual-facts"], "invariants": ["No solving"], "entry_conditions": ["MiMo route available"], "exit_conditions": ["Visual Facts Gate decided"]},
      {"id": "P2", "label": "Reasoning candidate generated", "state_in": ["approved problem", "visual-facts"], "state_out": ["answer candidate"], "invariants": ["No approval mutation"], "entry_conditions": ["DeepSeek API route available"], "exit_conditions": ["Answer contract validates"]},
      {"id": "P3", "label": "SVG candidate generated", "state_in": ["visual-facts", "answer candidate"], "state_out": ["validated SVG candidate"], "invariants": ["No unsafe SVG features"], "entry_conditions": ["Both fingerprints present"], "exit_conditions": ["SVG Gate decided"]},
      {"id": "P4", "label": "Teacher checkpoint reached", "state_in": ["answer candidate", "validated SVG candidate"], "state_out": ["needs-answer-review"], "invariants": ["No automatic approval"], "entry_conditions": ["Candidate validation passed"], "exit_conditions": ["Teacher reviews or requests revision"]}
    ],
    "transitions": [
      {"from": "P1", "to": "P2", "trigger": "source-approved", "carried_state": ["visual-facts"], "rollback_to": "P1"},
      {"from": "P2", "to": "P3", "trigger": "answer-contract-pass", "carried_state": ["answer candidate"], "rollback_to": "P2"},
      {"from": "P3", "to": "P4", "trigger": "svg-gate-pass", "carried_state": ["validated SVG candidate"], "rollback_to": "P3"}
    ]
  },
  "atomic_tasks": [
    {"id": "A1", "verb": "freeze", "description": "Freeze current routing and lifecycle baselines.", "target_ids": ["T4"], "process_node_ids": ["P1"], "depends_on": [], "input_artifacts": ["model-registry", "existing tests"], "output_artifact": "baseline-lock", "output_contract": "wuli.collaboration-baseline.v1", "verifier_route": "fingerprint-check", "assigned_role": "system", "max_attempts": 1, "terminal_states": ["passed", "failed"]},
    {"id": "A2", "verb": "define", "description": "Define the immutable wuli.visual-facts.v1 artifact and its separate wuli.visual-facts-gate-result.v1 decision.", "target_ids": ["T1"], "process_node_ids": ["P1"], "depends_on": ["A1"], "input_artifacts": ["source-review-contract", "human-gate-review"], "output_artifact": "visual-facts-contract-and-gate", "output_contract": "wuli.visual-facts.v1 + wuli.visual-facts-gate-result.v1", "verifier_route": "schema-gate-and-idempotence-tests", "assigned_role": "deepseek-v4-flash-api", "max_attempts": 2, "terminal_states": ["passed", "failed", "gate-dispute"]},
    {"id": "A3", "verb": "integrate", "description": "Route source visual extraction through the MiMo registry identity.", "target_ids": ["T1", "T4"], "process_node_ids": ["P1"], "depends_on": ["A2"], "input_artifacts": ["visual-facts-contract", "model-registry"], "output_artifact": "vision-integration-patch", "output_contract": "code-patch.v1", "verifier_route": "source-review-and-privacy-tests", "assigned_role": "deepseek-v4-flash-api", "max_attempts": 2, "terminal_states": ["passed", "failed"]},
    {"id": "A4", "verb": "route", "description": "Make DeepSeek API the explicit generation route and reject silent fallback.", "target_ids": ["T2", "T4"], "process_node_ids": ["P2"], "depends_on": ["A1"], "input_artifacts": ["model-registry", "gateway-contract"], "output_artifact": "generation-routing-patch", "output_contract": "code-patch.v1", "verifier_route": "registry-and-gateway-tests", "assigned_role": "deepseek-v4-flash-api", "max_attempts": 2, "terminal_states": ["passed", "failed"]},
    {"id": "A5", "verb": "compose", "description": "Replace MiMo-direct SVG generation with MiMo facts to DeepSeek SVG composition.", "target_ids": ["T3"], "process_node_ids": ["P3"], "depends_on": ["A3", "A4"], "input_artifacts": ["visual-facts-contract", "generation-routing-patch"], "output_artifact": "svg-collaboration-patch", "output_contract": "code-patch.v1", "verifier_route": "svg-provenance-and-safety-tests", "assigned_role": "deepseek-v4-flash-api", "max_attempts": 2, "terminal_states": ["passed", "failed"]},
    {"id": "A6", "verb": "bind", "description": "Bind visualization.model to DeepSeek structured physics-model generation while retaining simulator ownership.", "target_ids": ["T2", "T4"], "process_node_ids": ["P2"], "depends_on": ["A4"], "input_artifacts": ["generation-routing-patch", "visualization-contract"], "output_artifact": "visualization-routing-patch", "output_contract": "code-patch.v1", "verifier_route": "visualization-contract-tests", "assigned_role": "deepseek-v4-flash-api", "max_attempts": 2, "terminal_states": ["passed", "failed"]},
    {"id": "A7", "verb": "test", "description": "Run deterministic unit, privacy, failure-injection and integration tests.", "target_ids": ["T1", "T2", "T3", "T4"], "process_node_ids": ["P1", "P2", "P3", "P4"], "depends_on": ["A5", "A6"], "input_artifacts": ["all code patches"], "output_artifact": "collaboration-test-report", "output_contract": "wuli.collaboration-test-report.v1", "verifier_route": "local-test-runner", "assigned_role": "system", "max_attempts": 2, "terminal_states": ["passed", "failed"]},
    {"id": "A8", "verb": "replay", "description": "Replay the teacher workflow in an isolated temporary library and stop at answer review.", "target_ids": ["T4"], "process_node_ids": ["P4"], "depends_on": ["A7"], "input_artifacts": ["collaboration-test-report", "non-private fixture"], "output_artifact": "isolated-e2e-report", "output_contract": "wuli.collaboration-e2e.v1", "verifier_route": "lifecycle-state-check", "assigned_role": "system", "max_attempts": 1, "terminal_states": ["passed", "failed", "blocked"]}
  ],
  "state_transfers": [
