    {"id": "S2", "producer_task_id": "A2", "consumer_task_id": "A3", "artifact": "visual-facts-contract-and-gate", "contract": "wuli.visual-facts.v1 + wuli.visual-facts-gate-result.v1", "preconditions": ["Schema, gate, route-separation and idempotence tests pass"], "invalidation_rule": "Invalidate when visual facts fields, fingerprint rules, confidence threshold or gate result fields change."},
    {"id": "S3", "producer_task_id": "A1", "consumer_task_id": "A4", "artifact": "baseline-lock", "contract": "wuli.collaboration-baseline.v1", "preconditions": ["A1 passed"], "invalidation_rule": "Invalidate when registry or gateway routing changes."},
    {"id": "S4", "producer_task_id": "A3", "consumer_task_id": "A5", "artifact": "vision-integration-patch", "contract": "code-patch.v1", "preconditions": ["Vision and privacy tests pass"], "invalidation_rule": "Invalidate when vision adapter or source-review contract changes."},
    {"id": "S5", "producer_task_id": "A4", "consumer_task_id": "A5", "artifact": "generation-routing-patch", "contract": "code-patch.v1", "preconditions": ["Registry and gateway tests pass"], "invalidation_rule": "Invalidate when DeepSeek model identity or route changes."},
    {"id": "S6", "producer_task_id": "A4", "consumer_task_id": "A6", "artifact": "generation-routing-patch", "contract": "code-patch.v1", "preconditions": ["Registry and gateway tests pass"], "invalidation_rule": "Invalidate when visualization task route changes."},
    {"id": "S7", "producer_task_id": "A5", "consumer_task_id": "A7", "artifact": "svg-collaboration-patch", "contract": "code-patch.v1", "preconditions": ["SVG tests pass"], "invalidation_rule": "Invalidate when SVG inputs, generator or gate changes."},
    {"id": "S8", "producer_task_id": "A6", "consumer_task_id": "A7", "artifact": "visualization-routing-patch", "contract": "code-patch.v1", "preconditions": ["Visualization tests pass"], "invalidation_rule": "Invalidate when physics-model contract or simulator interface changes."},
    {"id": "S9", "producer_task_id": "A7", "consumer_task_id": "A8", "artifact": "collaboration-test-report", "contract": "wuli.collaboration-test-report.v1", "preconditions": ["All critical tests pass"], "invalidation_rule": "Invalidate when any scoped implementation file changes."}
  ],
  "verification_obligations": [
    {"id": "V1", "target_ids": ["T1"], "task_ids": ["A2", "A3"], "claim": "MiMo is the only runtime source of visual facts, uncertainty is preserved, and gate status is separate from the evidence artifact.", "required_evidence": ["visual-facts", "visual-facts-gate-result", "source-review-tests", "gateway-trace"], "method": "Inspect artifact identity shape, independent runtime trace, ambiguity fixtures, low-confidence fixtures and idempotence.", "decision_rule": "Every visual trace names MiMo; uncertainties remain in the artifact; uncertainty or low confidence produces needs-source-review without destroying evidence.", "defeaters": ["OCR-only approval", "DeepSeek repairs missing visual facts", "model route hard-coded as domain schema", "normalization treated as approval"], "fallback": "blocked", "risk": "critical"},
    {"id": "V2", "target_ids": ["T2"], "task_ids": ["A4", "A6"], "claim": "All authorized generation tasks use DeepSeek V4 Flash API.", "required_evidence": ["agent-stage-trace"], "method": "Resolve each task and compare exact model ID/provider.", "decision_rule": "All required routes equal deepseek-v4-flash-api/openai-compatible and no fallback notice exists.", "defeaters": ["tier override", "silent provider fallback"], "fallback": "blocked", "risk": "critical"},
    {"id": "V3", "target_ids": ["T3"], "task_ids": ["A5"], "claim": "SVG is a true two-model artifact and is safe to render.", "required_evidence": ["svg-provenance", "svg-gate-report"], "method": "Bind both fingerprints and inject unsafe SVG variants.", "decision_rule": "Both fingerprints match and every unsafe variant is rejected.", "defeaters": ["MiMo-direct SVG", "unbound visual facts", "scriptable SVG"], "fallback": "provisional", "risk": "critical"},
    {"id": "V4", "target_ids": ["T4"], "task_ids": ["A1", "A3", "A4", "A6", "A7", "A8"], "claim": "Privacy and teacher approval boundaries remain unchanged.", "required_evidence": ["privacy-tests", "isolated-e2e-report"], "method": "Run remote-gate failures and lifecycle replay.", "decision_rule": "Unauthorized calls fail closed and E2E stops at needs-answer-review.", "defeaters": ["automatic approval", "canonical mutation after failed provider"], "fallback": "blocked", "risk": "critical"}
  ],
