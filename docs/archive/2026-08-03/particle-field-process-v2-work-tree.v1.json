{
  "schema": "complex-process-decomposition.v1",
  "status": "completed",
  "problem_profile": {
    "summary": "在不改写现有正式题库和已批准仿真字节的前提下，建立 particle-field-process.v2，并用兼容适配器验证当前十二个带电粒子模型。",
    "process_shape": "hybrid",
    "epistemic_families": ["engineering", "procedural", "physics"],
    "source_policy": "provided-material",
    "authoritative_inputs": [
      "docs/particle-field-process-v2-contract.md",
      ".claude/skills/build-physics-simulator/references/physics-model.schema.json",
      ".claude/skills/build-physics-simulator/scripts/validate_physics_model.py",
      ".claude/skills/build-physics-simulator/scripts/build_simulator.py",
      "student-error-library/entries/*/physics-model.json"
    ],
    "assumptions": [
      "当前十二个 physics-model.json 是第一阶段回放全集，而不是未来任意题图的完备样本。",
      "DeepSeek V4 Flash API 只生成隔离候选，Codex 审核后才允许提升。",
      "旧模型在教师明确批准迁移前继续走原有 builder 和 renderer。"
    ],
    "constraints": [
      "不得修改正式 student-error-library 条目。",
      "不得修改教师批准记录、finish 或发布状态。",
      "不得把不支持的物理过程降级为流程图、自由曲线或无误差界 polyline。",
      "物理硬门控失败必须 fail-closed。",
      "每个 Flash 原子任务最多两次尝试，且每次必须使用冻结输入指纹。"
    ],
    "excluded_scope": [
      "其余七个顶层物理模型族的实现。",
      "旧六类 renderer 的删除。",
      "自动迁移正式题库。",
      "自动批准静态 SVG 或交互仿真。"
    ]
  },
  "targets": [
    {
      "id": "T1",
      "description": "建立可独立验证的 particle-field-process.v2 模型合同和 JSON Schema。",
      "success_criteria": [
        "二维/三维、单/多粒子、区域、场计划、阶段、事件、状态交接和视图均有强类型合同。",
        "未知传播规律和无效坐标系被拒绝。"
      ],
      "priority": "critical",
      "required_evidence": ["schema-validation-report", "schema-fault-injection-report"],
      "approval": "domain-expert"
    },
    {
      "id": "T2",
      "description": "实现确定性的阶段传播、状态连续性、事件顺序和几何不变量验证。",
      "success_criteria": [
        "纯电场、纯磁场、无场和已支持复合场遵守各自局部规律。",
        "圆心、半径、切线、旋向、能量和最早事件可被确定性检查。"
      ],
      "priority": "critical",
      "required_evidence": ["physics-validator-report", "geometry-compiler-report"],
      "approval": "domain-expert"
    },
    {
      "id": "T3",
      "description": "现有六类模型和十二个正式样本保持兼容且可进行只读语义对照。",
      "success_criteria": [
        "旧 model_type 继续由旧构建路径处理。",
        "十二个模型均可在临时目录产生 normalized-v2 对照结果。",
        "事件、案例、停止条件和关键几何等价。"
      ],
      "priority": "critical",
      "required_evidence": ["legacy-compatibility-report", "twelve-model-replay-report"],
      "approval": "system"
    },
    {
      "id": "T4",
      "description": "二维截面和三维投影只从验证后的几何 IR 生成，不再由自由 SVG 猜测圆心和空间关系。",
      "success_criteria": [
        "截面基、投影基和物理坐标分离。",
        "三维螺旋、斜面圆轨道和二维圆弧使用正确视图语义。"
      ],
      "priority": "high",
      "required_evidence": ["view-compiler-tests", "representative-png-review"],
      "approval": "human-owner"
    },
    {
      "id": "T5",
      "description": "Agent Gateway、教师批准和交付边界不因新模型而放宽。",
      "success_criteria": [
        "DeepSeek 只能写隔离候选。",
        "失败候选不改变 canonical。",
        "未支持模型返回 unsupported。"
      ],
      "priority": "critical",
      "required_evidence": ["gateway-regression-report", "lifecycle-boundary-report"],
      "approval": "human-owner"
    }
  ],
  "process_model": {
    "kind": "hybrid",
    "nodes": [
      {
        "id": "P1",
        "label": "合同与基线冻结",
        "state_in": ["approved-architecture-decision", "current-model-corpus"],
        "state_out": ["contract-v2", "baseline-lock"],
        "invariants": ["正式题库不变", "旧 builder 可运行"],
        "entry_conditions": ["模型清单和影响面可读取"],
        "exit_conditions": ["合同、样本清单和指纹完成"]
      },
      {
        "id": "P2",
        "label": "隔离实现候选",
        "state_in": ["contract-v2", "baseline-lock"],
        "state_out": ["tested-v2-candidate"],
        "invariants": ["Flash 不改 canonical", "硬门控不降级"],
        "entry_conditions": ["输入指纹固定"],
        "exit_conditions": ["局部合同和故障注入通过"]
      },
      {
        "id": "P3",
        "label": "旧模型语义对照",
        "state_in": ["tested-v2-candidate", "legacy-model-snapshots"],
        "state_out": ["twelve-model-replay-report"],
        "invariants": ["适配结果只写临时目录", "旧交付字节不重建"],
        "entry_conditions": ["schema、validator、compiler 通过"],
        "exit_conditions": ["十二题逐题形成等价或冲突记录"]
      },
      {
        "id": "P4",
        "label": "教师代表题审核",
        "state_in": ["twelve-model-replay-report", "representative-renders"],
        "state_out": ["promotion-decision"],
        "invariants": ["无自动批准"],
        "entry_conditions": ["所有 critical 自动检查通过"],
        "exit_conditions": ["教师批准、退回或保持 provisional"]
      }
    ],
    "transitions": [
      {
        "from": "P1",
        "to": "P2",
        "trigger": "contract-and-baseline-pass",
        "carried_state": ["contract-v2", "baseline-lock"],
        "rollback_to": "P1"
      },
      {
        "from": "P2",
        "to": "P3",
        "trigger": "candidate-tests-pass",
        "carried_state": ["tested-v2-candidate"],
        "rollback_to": "P2"
      },
      {
        "from": "P3",
        "to": "P2",
        "trigger": "semantic-equivalence-conflict",
        "carried_state": ["smallest-failing-adapter-or-validator"],
        "rollback_to": "P2"
      },
      {
        "from": "P3",
        "to": "P4",
        "trigger": "critical-replay-pass",
        "carried_state": ["twelve-model-replay-report", "representative-renders"],
        "rollback_to": "P2"
      },
      {
        "from": "P4",
        "to": "P2",
        "trigger": "teacher-requests-revision",
        "carried_state": ["review-findings"],
        "rollback_to": "P2"
      }
    ]
  },
